#!/bin/bash
# awake — keep this Mac awake for N hours, even with the lid closed.
#
#   awake            prompt for hours
#   awake 1          stay awake 1 hour
#   awake .5         stay awake 30 minutes
#   awake 24         stay awake a full day
#   awake mic 1      stay awake with the built-in mic available (lid open)
#   awake off        let the Mac sleep normally again
#   awake status     show how much awake-time is left
#   awake --version  print version
#   awake -h         show this help
#
# Keeps the display + system awake AND disables lid-close (clamshell) sleep,
# so you can shut the lid and keep running. Needs your Mac password once per
# session (disabling clamshell sleep requires admin). Survives closing the
# terminal; does NOT survive a reboot.
#
# Heads up: with the lid closed on battery, the Mac runs full-power with the
# screen off — it WILL drain the battery. Plug in for long sessions.
#
# Also: macOS turns off the built-in mic and camera while the lid is closed.
# They come back when you open it. If the mic doesn't, `awake off` and
# `awake status` notice and print the one command that brings it back.

set -euo pipefail

VERSION="1.1.0"

STATE="${AWAKE_STATE_DIR:-$HOME/.cache/awake}"
PIDFILE="$STATE/pid"
UNTILFILE="$STATE/until"
LIDFILE="$STATE/lid"
MICFILE="$STATE/mic"
MODEFILE="$STATE/mode"

die() {
  echo "awake: $*" >&2
  exit 1
}

# caffeinate + pmset are macOS-only. Fail fast with a clear line instead of a
# confusing "command not found" deep inside a command.
[[ "$(uname)" == "Darwin" ]] || die "only works on macOS (needs caffeinate + pmset)."

mkdir -p "$STATE"

usage() {
  cat <<'EOF'
awake — keep this Mac awake for N hours, even with the lid closed.

  awake            prompt for hours
  awake 1          stay awake 1 hour
  awake .5         stay awake 30 minutes
  awake 24         stay awake a full day
  awake mic 1      stay awake with the built-in mic available (lid open)
  awake off        let the Mac sleep normally again
  awake status     show how much awake-time is left
  awake --version  print version
  awake -h         show this help

Keeps the display + system awake AND disables lid-close (clamshell) sleep,
so you can shut the lid and keep running. Needs your Mac password once per
session (disabling clamshell sleep requires admin). Survives closing the
terminal; does NOT survive a reboot.

Heads up: with the lid closed on battery, the Mac runs full-power with the
screen off — it WILL drain the battery. Plug in for long sessions.

macOS also turns off the built-in mic and camera while the lid is closed. They
come back when you open it. If the mic doesn't come back, `awake off` and
`awake status` notice and print the one command that restores it.

`awake mic [hours]` keeps the system awake while allowing the built-in display
to sleep. Keep the lid open: the built-in microphone remains available and no
admin password is needed. An external microphone is required for lid-closed use.
EOF
}

clock() { date -r "$1" '+%-I:%M %p'; } # epoch seconds -> "4:57 PM"

# True only when the caffeinate we recorded is still running AND its timer
# hasn't passed — i.e. a genuine, live awake session (not a ghost from a
# reboot or an expired timer whose files linger).
session_active() {
  [[ -f "$PIDFILE" && -f "$UNTILFILE" ]] || return 1
  local p _
  read -r p _ <"$PIDFILE" 2>/dev/null || return 1
  [[ -n "${p:-}" ]] && kill -0 "$p" 2>/dev/null || return 1
  local now until_epoch
  now=$(date +%s)
  until_epoch=$(cat "$UNTILFILE" 2>/dev/null || echo 0)
  [[ "$until_epoch" =~ ^[0-9]+$ ]] || return 1
  ((until_epoch > now))
}

# Read LIVE clamshell-sleep state, no sudo. `pmset -g` needs no admin to READ;
# only WRITING disablesleep does. Returns 0 (true) when sleep is disabled
# system-wide right now — whatever our tracked files happen to say.
sleep_disabled_now() {
  local v
  v=$(pmset -g 2>/dev/null | awk '/SleepDisabled/ {print $2; exit}') || true
  [[ "$v" == "1" ]]
}

# Is the lid shut right now? macOS turns the built-in mic and camera off while
# it is, so this tells the mic check whether a missing mic is expected.
lid_closed() {
  ioreg -r -k AppleClamshellState -d 4 2>/dev/null |
    awk -F'= ' '/"AppleClamshellState"/ {print $2; exit}' |
    grep -qi 'yes'
}

# Does a built-in microphone exist right now? True when some audio device
# reports both a built-in transport and at least one input channel. Runs in
# about half a second; only called at session boundaries, never in a loop.
builtin_mic_present() {
  system_profiler -json SPAudioDataType 2>/dev/null | awk '
    /\{/ { builtin = 0; input = 0 }
    /"coreaudio_device_transport" *: *"coreaudio_device_type_builtin"/ { builtin = 1 }
    /"coreaudio_device_input" *: *[1-9]/ { input = 1 }
    /\}/ { if (builtin && input) found = 1; builtin = 0; input = 0 }
    END { exit !found }
  '
}

# Say something only when the built-in mic is genuinely missing and the user can
# act on it. Three guards, all required:
#   - we recorded a built-in mic when this session started, so a Mac mini or
#     Studio (no built-in mic ever) never gets a false alarm;
#   - the lid is open, because with it shut the mic is SUPPOSED to be off;
#   - the mic is in fact gone now.
# Deliberately does NOT restart coreaudiod itself — that is a systemwide daemon
# and killing it cuts audio in every running app, which is not a thing a sleep
# utility should do behind your back. It prints the command instead.
report_missing_mic() {
  [[ -f "$MICFILE" ]] || return 0
  lid_closed && return 0
  builtin_mic_present && return 0
  cat >&2 <<'EOF'
🎙  Your built-in microphone hasn't come back. macOS turns it off while the lid
    is closed, and sometimes the audio daemon doesn't re-register it on the way
    back. Restart the daemon and it reappears:

        sudo killall coreaudiod

    It relaunches itself. Any app recording or on a call right now loses its
    audio, so do this between calls.
EOF
}

# Drop dead-PID / expired session markers so no command acts on a ghost.
cleanup_stale() {
  if [[ -f "$PIDFILE" || -f "$UNTILFILE" ]] && ! session_active; then
    rm -f "$PIDFILE" "$UNTILFILE"
  fi
}

# Stop the caffeinate we started.
stop_caffeinate() {
  local p="" secs=""
  if [[ -f "$PIDFILE" ]]; then
    read -r p secs <"$PIDFILE" 2>/dev/null || true
    if [[ -n "${p:-}" ]] && kill -0 "$p" 2>/dev/null; then
      kill "$p" 2>/dev/null || true
    fi
  fi
  # Fallback for an orphaned caffeinate we can no longer PID-track (e.g. the
  # pid file was cleared by hand). This is a PATTERN match on the command line,
  # NOT proof of ownership: pkill signals ANY process whose argv matches. When
  # we still know the exact `-t <seconds>` we launched with, we anchor the
  # pattern to it, which makes an accidental hit on an unrelated caffeinate
  # unlikely — but nothing here guarantees the match is the process we started.
  # caffeinate's flags are stable and no common tool uses this exact
  # invocation, so we accept that tradeoff.
  if [[ "${secs:-}" =~ ^[0-9]+$ ]]; then
    pkill -f "caffeinate -dimsu -t ${secs}\$" 2>/dev/null || true
    pkill -f "caffeinate -imsu -t ${secs}\$" 2>/dev/null || true
  else
    pkill -f 'caffeinate -dimsu -t' 2>/dev/null || true
    pkill -f 'caffeinate -imsu -t' 2>/dev/null || true
  fi
  rm -f "$PIDFILE" "$UNTILFILE"
}

# Restore normal clamshell sleep — but only reach for sudo when LIVE system
# state actually shows sleep disabled. This is the reboot-proof half of the
# fix: it trusts `pmset -g`, not the lid marker, so a stuck disablesleep=1 with
# no tracked session (dead caffeinate, wiped/edited cache) still gets cleared.
# When no lid session was ever active, SleepDisabled is already 0 and this
# stays password-free.
restore_lid_if_needed() {
  if sleep_disabled_now; then
    echo "🔒  Restoring normal sleep needs admin access (your Mac password)."
    sudo pkill -f 'awake-lid-guard' 2>/dev/null || true
    sudo pmset -a disablesleep 0 2>/dev/null || true
    if sleep_disabled_now; then
      echo "⚠️  Couldn't restore sleep — it's still disabled. Try:  sudo pmset -a disablesleep 0" >&2
    fi
  fi
  rm -f "$LIDFILE"
}

cleanup_stale

cmd="${1:-}"
mic_mode=0
if [[ "$cmd" == "mic" ]]; then
  mic_mode=1
  shift
  cmd="${1:-}"
fi

case "$cmd" in
off | stop | none | 0)
  stop_caffeinate
  restore_lid_if_needed
  echo "☕️→😴  Caffeine off. Your Mac can sleep normally now."
  report_missing_mic
  rm -f "$MICFILE" "$MODEFILE"
  exit 0
  ;;
status | st)
  if session_active; then
    now=$(date +%s)
    until_epoch=$(cat "$UNTILFILE")
    left=$((until_epoch - now))
    if [[ -f "$LIDFILE" ]]; then
      printf "☕️🔒  Awake for %dh %dm more (until %s) — lid can be closed.\n" \
        $((left / 3600)) $(((left % 3600) / 60)) "$(clock "$until_epoch")"
    elif [[ -f "$MODEFILE" && "$(cat "$MODEFILE")" == "mic" ]]; then
      printf "☕️🎙  Awake for %dh %dm more (until %s) — lid open; built-in mic available.\n" \
        $((left / 3600)) $(((left % 3600) / 60)) "$(clock "$until_epoch")"
    else
      printf "☕️  Awake for %dh %dm more (until %s) — idle only.\n" \
        $((left / 3600)) $(((left % 3600) / 60)) "$(clock "$until_epoch")"
    fi
  else
    echo "😴  Not currently caffeinated."
  fi
  # Detection half of the reboot fix: surface a stuck disablesleep even when
  # nothing is tracked, so the user knows how to recover.
  if sleep_disabled_now && ! session_active; then
    echo "⚠️  Sleep is disabled system-wide but no awake session is tracked — run  awake off  to restore normal sleep." >&2
  fi
  report_missing_mic
  exit 0
  ;;
-h | --help | help)
  usage
  exit 0
  ;;
--version | version)
  echo "awake $VERSION"
  exit 0
  ;;
esac

# --- start a new awake session ---
hours="$cmd"
if [[ -z "$hours" ]]; then
  if ((mic_mode == 1)); then
    read -rp "Keep Mac awake with its built-in mic for how many hours? (.5=30min · 1=1hr · 24=day): " hours || true
  else
    read -rp "Keep Mac awake for how many hours? (.5=30min · 1=1hr · 24=day): " hours || true
  fi
fi

# Validate BEFORE any arithmetic. The regex gate guarantees $hours is a plain
# number, so interpolating it into awk below can't inject anything.
if ! [[ "$hours" =~ ^[0-9]*\.?[0-9]+$ ]] || awk "BEGIN{exit !($hours <= 0)}"; then
  die "please give a positive number of hours, e.g. .5, 1, or 24."
fi

seconds=$(awk "BEGIN{printf \"%d\", $hours * 3600}")
((seconds < 1)) && seconds=1

# Disabling clamshell sleep needs admin. Prompt once up front and cache the
# credential so the background guard starts without a second prompt. Cancel the
# password to fall back to idle-only awake (closing the lid will still sleep).
lid_ok=0
if ((mic_mode == 1)); then
  echo "🎙  Mic mode keeps the built-in microphone available while the lid stays open."
else
  echo "🔒  Keeping the lid awake needs admin access (your Mac password)."
  if sudo -v; then
    lid_ok=1
  else
    echo "    No password given — starting idle-only (closing the lid will still sleep)."
  fi
fi

stop_caffeinate # replace any caffeinate we already started

# Tear down any guard left over from an earlier session. Live-state-checked
# (like `off`), so this still runs even if this invocation's own password
# prompt below is declined — a stale guard from a PRIOR session can otherwise
# keep disablesleep=1 in force while we print "closing the lid will still
# sleep," which would be a lie.
restore_lid_if_needed

# Record whether a built-in mic exists BEFORE the lid can close, so that after
# the session we can tell "macOS didn't give it back" apart from "this Mac never
# had one." Only meaningful for a lid session; idle-only sessions never lose it.
rm -f "$MICFILE" "$MODEFILE"
if ((lid_ok == 1)) && builtin_mic_present; then
  echo 1 >"$MICFILE"
fi

if ((mic_mode == 1)); then
  echo mic >"$MODEFILE"
  nohup caffeinate -imsu -t "$seconds" >/dev/null 2>&1 &
else
  nohup caffeinate -dimsu -t "$seconds" >/dev/null 2>&1 &
fi
printf '%s %s\n' "$!" "$seconds" >"$PIDFILE"
echo "$(($(date +%s) + seconds))" >"$UNTILFILE"

if ((lid_ok == 1)); then
  # One root-owned guard: disable clamshell sleep, wait out the timer, restore.
  # Runs entirely as root (already elevated) so it never re-prompts. The
  # 'awake-lid-guard' marker lets `awake off` find and kill it. nohup so it
  # survives closing this terminal.
  nohup sudo bash -c ': awake-lid-guard ; pmset -a disablesleep 1 ; sleep '"$seconds"' ; pmset -a disablesleep 0' >/dev/null 2>&1 &
  echo "$(($(date +%s) + seconds))" >"$LIDFILE"
fi

h=$((seconds / 3600))
m=$(((seconds % 3600) / 60))
dur=""
((h > 0)) && dur="${h}h"
((m > 0)) && dur="${dur}${m}m"
[[ -z "$dur" ]] && dur="${seconds}s"

if ((mic_mode == 1)); then
  printf "☕️🎙  Mac will stay awake for %s (until %s) — lid stays OPEN; built-in mic available.\n" "$dur" "$(clock "$(cat "$UNTILFILE")")"
  echo "    The display may sleep; use an external microphone if you need the lid closed."
elif ((lid_ok == 1)); then
  printf "☕️🔒  Mac will stay awake for %s (until %s) — lid can be CLOSED.\n" "$dur" "$(clock "$(cat "$UNTILFILE")")"
  echo "    Runs full-power with the screen off — plug in for long sessions."
else
  printf "☕️  Mac will stay awake for %s (until %s) — idle only.\n" "$dur" "$(clock "$(cat "$UNTILFILE")")"
fi
echo "    Close this terminal freely. Stop early (and restore sleep) with:  awake off"
