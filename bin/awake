#!/bin/bash
# awake — keep this Mac awake for N hours; optional lid-close support.
#
#   awake            prompt for hours
#   awake 1 unlock   stay awake and prevent idle locking for 1 hour
#   awake unlock     prompt for hours with idle-lock prevention
#   awake 1          stay awake 1 hour, no password
#   awake 1 lid      also suppress lid-close sleep (admin required)
#   awake .5         stay awake 30 minutes
#   awake 24         stay awake a full day
#   awake off        let the Mac sleep normally again
#   awake status     show how much awake-time is left
#   awake --version  print version
#   awake -h         show this help
#
# Keeps the display + system awake without admin access. Add lid to suppress
# clamshell sleep; only that option needs your Mac password. Survives closing
# the terminal; does NOT survive a reboot.
#
# Heads up: with the lid closed on battery, the Mac runs full-power with the
# screen off — it WILL drain the battery. Plug in for long sessions.
#
# macOS turns off the built-in mic and camera while the lid is closed. Awake
# watches for the lid to reopen and restarts the audio service only if the mic
# fails to return. An external mic remains the option while the lid is shut.

set -euo pipefail

VERSION="4.0.0"

STATE="${AWAKE_STATE_DIR:-$HOME/.cache/awake}"
PIDFILE="$STATE/pid"
UNTILFILE="$STATE/until"
LIDFILE="$STATE/lid"
MICFILE="$STATE/mic"
UNLOCKDIR="$STATE/unlock"
SCRIPT_PATH="${BASH_SOURCE[0]}"
RECOVERY_LABEL="com.dancumberland.awake.unlock.$(printf %s "$STATE" | cksum | awk '{print $1}')"
RECOVERY_DOMAIN="gui/$(id -u)"
RECOVERY_PLIST="${AWAKE_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}/$RECOVERY_LABEL.plist"

die() {
  echo "awake: $*" >&2
  exit 1
}

# caffeinate + pmset are macOS-only. Fail fast with a clear line instead of a
# confusing "command not found" deep inside a command.
[[ "$(uname)" == "Darwin" ]] || die "only works on macOS (needs caffeinate + pmset)."

mkdir -p "$STATE"

usage() {
  cat <<'EOF'
awake — keep this Mac awake for N hours; optional lid-close support.

  awake            prompt for hours
  awake 1 unlock   stay awake and prevent idle locking for 1 hour
  awake unlock     prompt for hours with idle-lock prevention
  awake 1          stay awake 1 hour, no password
  awake 1 lid      also suppress lid-close sleep (admin required)
  awake 1 unlock lid  combine idle-lock prevention and lid-sleep suppression
  awake .5         stay awake 30 minutes
  awake 24         stay awake a full day
  awake off        let the Mac sleep normally again
  awake status     show how much awake-time is left
  awake --version  print version
  awake -h         show this help

Normal awake and unlock sessions need no admin password. Keep the lid open,
or use macOS closed-display mode with an external display, power, and input
devices. Add lid for laptop-only lid-sleep suppression; that option needs admin
access and does not guarantee an unlocked, usable GUI with the lid closed.
Survives closing the terminal; does NOT survive a reboot.

Unlock is optional: enter "1 unlock" at the prompt, or run "awake 1 unlock".
It temporarily pauses the automatic screen saver and restores its previous
timeout on expiry, replacement, or awake off. Your password settings stay intact.
Start unlocked and keep the lid open for GUI agents. Manual locks, lid-close
locks, and managed security policies are not bypassed.

Heads up: with the lid closed on battery, the Mac runs full-power with the
screen off — it WILL drain the battery. Plug in for long sessions.

macOS turns off the built-in mic and camera while the lid is physically closed.
Awake watches for the lid to reopen. If the built-in mic does not return after a
short grace period, Awake restarts the Mac audio service automatically. Use an
external microphone if you need audio input while the lid remains closed.
EOF
}

clock() { date -r "$1" '+%-I:%M %p'; } # epoch seconds -> "4:57 PM"

# Unlock mode pauses only the idle screen saver, never the password check.
# Save the exact host-specific timeout (including an absent key) before changing
# it. The detached guard restores it on timeout, loss of caffeinate, or TERM.
# An independent launchd job recovers a killed guard or reboot automatically.
# Status/off/start retain synchronous recovery if launchd is unavailable.
acquire_command_lock() {
  local attempts="${1:-50}" attempt
  for ((attempt = 0; attempt < attempts; attempt++)); do
    if shlock -f "$STATE/command.lock" -p "$$"; then
      trap 'rm -f "$STATE/command.lock"' EXIT
      return 0
    fi
    sleep 0.1
  done
  return 1
}

read_saver_timeout() {
  defaults -currentHost read com.apple.screensaver idleTime 2>/dev/null
}

restore_unlock() {
  [[ -f "$UNLOCKDIR/original" ]] || return 0
  [[ ! -f "$UNLOCKDIR/restored" ]] || return 0
  local original current
  original=$(cat "$UNLOCKDIR/original")
  current=$(read_saver_timeout || true)
  # Preserve an intentional change the user made during the session.
  if [[ "$current" == "0" ]]; then
    if [[ "$original" == "absent" ]]; then
      defaults -currentHost delete com.apple.screensaver idleTime || return 1
    elif [[ "$original" =~ ^[0-9]+$ ]]; then
      defaults -currentHost write com.apple.screensaver idleTime -int "$original" || return 1
    else
      return 1
    fi
    current=$(read_saver_timeout || true)
    if [[ "$original" == "absent" ]]; then
      [[ -z "$current" ]] || return 1
    else
      [[ "$current" == "$original" ]] || return 1
    fi
  fi
  touch "$UNLOCKDIR/restored"
}

unlock_guard_running() {
  local p
  [[ -f "$UNLOCKDIR/pid" ]] || return 1
  p=$(cat "$UNLOCKDIR/pid")
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$p" 2>/dev/null || return 1
  # Do not signal a reused PID belonging to another process.
  [[ "$(ps -p "$p" -o command= 2>/dev/null)" == *"awake-unlock-guard"* ]]
}

xml_text() {
  printf %s "$1" | sed 's/\&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

remove_unlock_recovery() {
  # Unlink first: bootout can terminate this very process on a recovery run.
  rm -f "$RECOVERY_PLIST"
  launchctl bootout "$RECOVERY_DOMAIN/$RECOVERY_LABEL" >/dev/null 2>&1 || true
}

install_unlock_recovery() {
  local recovery_dir
  recovery_dir=$(dirname "$RECOVERY_PLIST")
  mkdir -p "$recovery_dir" || return 1
  cat >"$RECOVERY_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$RECOVERY_LABEL</string>
<key>ProgramArguments</key><array><string>/bin/bash</string><string>$(xml_text "$SCRIPT_PATH")</string><string>awake-unlock-recovery</string></array>
<key>EnvironmentVariables</key><dict><key>AWAKE_STATE_DIR</key><string>$(xml_text "$STATE")</string><key>AWAKE_LAUNCH_AGENTS_DIR</key><string>$(xml_text "$recovery_dir")</string></dict>
<key>RunAtLoad</key><true/>
<key>StartInterval</key><integer>5</integer>
<key>StandardOutPath</key><string>$(xml_text "$STATE/unlock-recovery.log")</string>
<key>StandardErrorPath</key><string>$(xml_text "$STATE/unlock-recovery.log")</string>
</dict></plist>
EOF
  launchctl bootstrap "$RECOVERY_DOMAIN" "$RECOVERY_PLIST" || return 1
  launchctl print "$RECOVERY_DOMAIN/$RECOVERY_LABEL" >/dev/null 2>&1
}

run_unlock_recovery() {
  acquire_command_lock 1 || return 0
  if [[ ! -f "$UNLOCKDIR/original" ]]; then
    remove_unlock_recovery
    return 0
  fi
  # The guard waits until this job is registered before touching preferences.
  if unlock_guard_running && session_active; then
    return 0
  fi
  echo "$(date '+%Y-%m-%dT%H:%M:%S%z') Recovering ended or failed unlock session."
  stop_unlock
}

stop_unlock() {
  if [[ ! -d "$UNLOCKDIR" ]]; then
    [[ ! -f "$RECOVERY_PLIST" ]] || remove_unlock_recovery
    return 0
  fi
  local p attempt
  if unlock_guard_running; then
    p=$(cat "$UNLOCKDIR/pid")
    kill -TERM "$p" 2>/dev/null || true
    for ((attempt = 0; attempt < 40; attempt++)); do
      unlock_guard_running || break
      sleep 0.1
    done
    if unlock_guard_running; then
      echo "awake: unlock guard did not stop; screen-saver recovery is pending. Run awake off again." >&2
      return 1
    fi
  fi
  restore_unlock || {
    echo "awake: could not restore the screen-saver timeout. Recovery state retained; run awake off again." >&2
    return 1
  }
  rm -f "$UNLOCKDIR/ready" "$UNLOCKDIR/restored" "$UNLOCKDIR/pid" "$UNLOCKDIR/original" "$UNLOCKDIR/supervised"
  rmdir "$UNLOCKDIR"
  remove_unlock_recovery
}

run_unlock_guard() {
  local deadline="$1" caffeine_pid="$2" attempt
  trap 'restore_unlock || echo "awake: screen-saver restoration failed; run awake off." >&2' EXIT
  trap 'exit 0' TERM INT HUP
  echo "$$" >"$UNLOCKDIR/pid"
  for ((attempt = 0; attempt < 50; attempt++)); do
    [[ ! -f "$UNLOCKDIR/supervised" ]] || break
    sleep 0.1
  done
  [[ -f "$UNLOCKDIR/supervised" ]] || exit 1
  defaults -currentHost write com.apple.screensaver idleTime -int 0
  [[ "$(read_saver_timeout)" == "0" ]] || exit 1
  touch "$UNLOCKDIR/ready"
  while (($(date +%s) < deadline)) && kill -0 "$caffeine_pid" 2>/dev/null; do
    sleep 1
  done
}

start_unlock() {
  local original caffeine_pid guard_pid attempt
  mkdir "$UNLOCKDIR" || return 1
  if original=$(read_saver_timeout); then
    if ! [[ "$original" =~ ^[0-9]+$ ]]; then
      echo "awake: unexpected screen-saver timeout; unlock was not enabled." >&2
      rmdir "$UNLOCKDIR"
      return 1
    fi
  else
    # An absent preference is valid; its effective default belongs to macOS.
    original=absent
  fi
  printf '%s\n' "$original" >"$UNLOCKDIR/original" || return 1
  read -r caffeine_pid _ <"$PIDFILE" || return 1
  nohup "$SCRIPT_PATH" awake-unlock-guard "$(cat "$UNTILFILE")" "$caffeine_pid" >>"$STATE/unlock.log" 2>&1 &
  guard_pid=$!
  echo "$guard_pid" >"$UNLOCKDIR/pid" || return 1
  if ! install_unlock_recovery; then
    stop_unlock || true
    return 1
  fi
  touch "$UNLOCKDIR/supervised" || return 1
  for ((attempt = 0; attempt < 40; attempt++)); do
    if [[ -f "$UNLOCKDIR/ready" ]] && unlock_guard_running; then
      return 0
    fi
    sleep 0.1
  done
  stop_unlock || return 1
  return 1
}

# True only when the caffeinate we recorded is still running AND its timer
# hasn't passed — i.e. a genuine, live awake session (not a ghost from a
# reboot or an expired timer whose files linger).
session_active() {
  [[ -f "$PIDFILE" && -f "$UNTILFILE" ]] || return 1
  local p _
  read -r p _ <"$PIDFILE" 2>/dev/null || return 1
  [[ -n "${p:-}" ]] && kill -0 "$p" 2>/dev/null || return 1
  local now until_epoch
  now=$(date +%s)
  until_epoch=$(cat "$UNTILFILE" 2>/dev/null || echo 0)
  [[ "$until_epoch" =~ ^[0-9]+$ ]] || return 1
  ((until_epoch > now))
}

# Read LIVE clamshell-sleep state, no sudo. `pmset -g` needs no admin to READ;
# only WRITING disablesleep does. Returns 0 (true) when sleep is disabled
# system-wide right now — whatever our tracked files happen to say.
sleep_disabled_now() {
  local v
  v=$(pmset -g 2>/dev/null | awk '/SleepDisabled/ {print $2; exit}') || true
  [[ "$v" == "1" ]]
}

# Is the lid shut right now? macOS turns the built-in mic and camera off while
# it is, so this tells the mic check whether a missing mic is expected.
lid_closed() {
  ioreg -r -k AppleClamshellState -d 4 2>/dev/null |
    awk -F'= ' '/"AppleClamshellState"/ {print $2; exit}' |
    grep -qi 'yes'
}

# Does a built-in microphone exist right now? True when some audio device
# reports both a built-in transport and at least one input channel. Runs in
# about half a second; only called at session boundaries, never in a loop.
builtin_mic_present() {
  system_profiler -json SPAudioDataType 2>/dev/null | awk '
    /\{/ { builtin = 0; input = 0 }
    /"coreaudio_device_transport" *: *"coreaudio_device_type_builtin"/ { builtin = 1 }
    /"coreaudio_device_input" *: *[1-9]/ { input = 1 }
    /\}/ { if (builtin && input) found = 1; builtin = 0; input = 0 }
    END { exit !found }
  '
}

# Give macOS a moment to re-register the built-in mic after the lid opens. If
# it remains missing, restart the audio service. This runs inside the root-owned
# lid guard, so it can repair the device without asking for another password.
recover_builtin_mic() {
  local mic_expected="${1:-0}"
  [[ "$mic_expected" == "1" ]] || return 0
  lid_closed && return 0
  sleep "${AWAKE_MIC_GRACE_SECONDS:-4}"
  builtin_mic_present && return 0
  killall coreaudiod 2>/dev/null || true
}

# Root-owned session guard. It holds off lid-close sleep, watches for a
# closed-to-open lid transition, repairs the built-in mic if macOS fails to
# return it, and always restores normal sleep when it exits.
run_lid_guard() {
  local seconds="$1"
  local mic_expected="${2:-0}"
  local deadline now saw_closed=0
  deadline=$(($(date +%s) + seconds))

  trap 'pmset -a disablesleep 0 >/dev/null 2>&1 || true' EXIT
  trap 'exit 0' TERM INT
  pmset -a disablesleep 1

  while :; do
    now=$(date +%s)
    ((now < deadline)) || break
    if lid_closed; then
      saw_closed=1
    elif ((saw_closed == 1)); then
      recover_builtin_mic "$mic_expected"
      saw_closed=0
    fi
    sleep "${AWAKE_LID_POLL_SECONDS:-1}"
  done
}

# Say something only when the built-in mic is genuinely missing and the user can
# act on it. Three guards, all required:
#   - we recorded a built-in mic when this session started, so a Mac mini or
#     Studio (no built-in mic ever) never gets a false alarm;
#   - the lid is open, because with it shut the mic is SUPPOSED to be off;
#   - the mic is in fact gone now.
# This is the fallback path if the root-owned lid guard could not repair the mic
# automatically. Read-only status/off calls print the manual command rather than
# restarting a systemwide audio service outside the detected reopen event.
report_missing_mic() {
  [[ -f "$MICFILE" ]] || return 0
  lid_closed && return 0
  builtin_mic_present && return 0
  cat >&2 <<'EOF'
🎙  Your built-in microphone hasn't come back. macOS turns it off while the lid
    is closed, and sometimes the audio daemon doesn't re-register it on the way
    back. Restart the daemon and it reappears:

        sudo killall coreaudiod

    It relaunches itself. Any app recording or on a call right now loses its
    audio, so do this between calls.
EOF
}

# Drop dead-PID / expired session markers so no command acts on a ghost.
cleanup_stale() {
  if [[ -f "$PIDFILE" || -f "$UNTILFILE" ]] && ! session_active; then
    rm -f "$PIDFILE" "$UNTILFILE"
  fi
}

# Stop the caffeinate we started.
stop_caffeinate() {
  local p="" secs=""
  if [[ -f "$PIDFILE" ]]; then
    read -r p secs <"$PIDFILE" 2>/dev/null || true
    if [[ -n "${p:-}" ]] && kill -0 "$p" 2>/dev/null; then
      kill "$p" 2>/dev/null || true
    fi
  fi
  # Fallback for an orphaned caffeinate we can no longer PID-track (e.g. the
  # pid file was cleared by hand). This is a PATTERN match on the command line,
  # NOT proof of ownership: pkill signals ANY process whose argv matches. When
  # we still know the exact `-t <seconds>` we launched with, we anchor the
  # pattern to it, which makes an accidental hit on an unrelated caffeinate
  # unlikely — but nothing here guarantees the match is the process we started.
  # caffeinate's flags are stable and no common tool uses this exact
  # invocation, so we accept that tradeoff.
  if [[ "${secs:-}" =~ ^[0-9]+$ ]]; then
    pkill -f "caffeinate -dimsu -t ${secs}\$" 2>/dev/null || true
    pkill -f "caffeinate -imsu -t ${secs}\$" 2>/dev/null || true
  else
    pkill -f 'caffeinate -dimsu -t' 2>/dev/null || true
    pkill -f 'caffeinate -imsu -t' 2>/dev/null || true
  fi
  rm -f "$PIDFILE" "$UNTILFILE"
}

# Restore normal clamshell sleep — but only reach for sudo when LIVE system
# state actually shows sleep disabled. This is the reboot-proof half of the
# fix: it trusts `pmset -g`, not the lid marker, so a stuck disablesleep=1 with
# no tracked session (dead caffeinate, wiped/edited cache) still gets cleared.
# When no lid session was ever active, SleepDisabled is already 0 and this
# stays password-free.
restore_lid_if_needed() {
  if sleep_disabled_now; then
    echo "🔒  Restoring normal sleep needs admin access (your Mac password)."
    sudo pkill -f 'awake-lid-guard' 2>/dev/null || true
    sudo pmset -a disablesleep 0 2>/dev/null || true
    if sleep_disabled_now; then
      echo "⚠️  Couldn't restore sleep — it's still disabled. Try:  sudo pmset -a disablesleep 0" >&2
    fi
  fi
  rm -f "$LIDFILE"
}

case "${1:-}" in
awake-unlock-recovery)
  run_unlock_recovery
  exit 0
  ;;
awake-unlock-guard)
  run_unlock_guard "${2:?missing deadline}" "${3:?missing caffeinate PID}"
  exit 0
  ;;
awake-lid-guard)
  run_lid_guard "${2:?missing guard duration}" "${3:-0}"
  exit 0
  ;;
awake-mic-recover)
  recover_builtin_mic "${2:-0}"
  exit 0
  ;;
esac

cmd="${1:-}"

case "$cmd" in
off | stop | none | 0)
  [[ $# -eq 1 ]] || die "usage: awake off"
  acquire_command_lock || die "another awake command is still running; try again shortly."
  cleanup_stale
  stop_unlock || exit 1
  stop_caffeinate
  restore_lid_if_needed
  echo "☕️→😴  Caffeine off. Your Mac can sleep normally now."
  report_missing_mic
  rm -f "$MICFILE"
  exit 0
  ;;
status | st)
  [[ $# -eq 1 ]] || die "usage: awake status"
  acquire_command_lock || die "another awake command is still running; try again shortly."
  cleanup_stale
  if [[ -d "$UNLOCKDIR" ]] && ! unlock_guard_running; then
    stop_unlock || exit 1
  fi
  if session_active; then
    now=$(date +%s)
    until_epoch=$(cat "$UNTILFILE")
    left=$((until_epoch - now))
    if [[ -f "$LIDFILE" ]]; then
      printf "☕️🔒  Awake for %dh %dm more (until %s) — lid can be closed.\n" \
        $((left / 3600)) $(((left % 3600) / 60)) "$(clock "$until_epoch")"
    else
      printf "☕️  Awake for %dh %dm more (until %s) — idle only.\n" \
        $((left / 3600)) $(((left % 3600) / 60)) "$(clock "$until_epoch")"
    fi
  else
    echo "😴  Not currently caffeinated."
  fi
  # Detection half of the reboot fix: surface a stuck disablesleep even when
  # nothing is tracked, so the user knows how to recover.
  if sleep_disabled_now && ! session_active; then
    echo "⚠️  Sleep is disabled system-wide but no awake session is tracked — run  awake off  to restore normal sleep." >&2
  fi
  if [[ -f "$UNLOCKDIR/ready" ]] && unlock_guard_running && [[ "$(read_saver_timeout || true)" == "0" ]]; then
    echo "🔓  Idle-lock prevention is active; password settings are unchanged."
  fi
  report_missing_mic
  exit 0
  ;;
-h | --help | help)
  usage
  exit 0
  ;;
--version | version)
  echo "awake $VERSION"
  exit 0
  ;;
esac

# --- start a new awake session ---
# Accept hours, unlock, and lid in any order, including an interactive line.
unlock=0
lid_requested=0
hours=""
parse_start_args() {
  local arg
  for arg in "$@"; do
    case "$arg" in
    lid)
      ((lid_requested == 0)) || die "use lid only once."
      lid_requested=1
      ;;
    unlock)
      ((unlock == 0)) || die "use unlock only once."
      unlock=1
      ;;
    *)
      [[ -z "$hours" ]] || die "please give one positive number of hours, optionally with unlock or lid (e.g. awake 1 unlock)."
      hours="$arg"
      ;;
    esac
  done
}
parse_start_args "$@"
if [[ -z "$hours" ]]; then
  echo 'Hours: .5 = 30 minutes · 1 = 1 hour · 2 = 2 hours · 8 = workday · 24 = day'
  if ((unlock == 0)); then
    echo 'Add unlock to prevent idle locking too, e.g. 1 unlock (keep the lid open).'
  fi
  if ((lid_requested == 0)); then
    echo 'Optional: add lid for laptop-only lid-sleep suppression (admin password required).'
  fi
  read -rp "Keep Mac awake for how long? " -a answer || true
  parse_start_args "${answer[@]}"
fi

# Validate BEFORE any arithmetic. The regex gate guarantees $hours is a plain
# number, so interpolating it into awk below can't inject anything.
if ! [[ "$hours" =~ ^[0-9]*\.?[0-9]+$ ]] || awk "BEGIN{exit !($hours <= 0)}"; then
  die "please give a positive number of hours, e.g. .5, 1, or 24."
fi

seconds=$(awk "BEGIN{printf \"%d\", $hours * 3600}")
((seconds < 1)) && seconds=1

# Only explicit lid mode authenticates. Ordinary awake/unlock never asks for
# admin. An old system-wide sleep override needs its own explicit cleanup.
lid_ok=0
if ((lid_requested == 1)); then
  echo "🔒  Keeping the lid awake needs admin access (your Mac password)."
  if sudo -v; then
    lid_ok=1
  else
    echo "    No password given — starting idle-only (closing the lid will still sleep)."
  fi
elif sleep_disabled_now; then
  die "sleep is already disabled system-wide. Run awake off once to restore it (admin may be required), then retry this password-free session."
fi

acquire_command_lock || die "another awake command is still running; try again shortly."
cleanup_stale
if ((lid_requested == 0)) && sleep_disabled_now; then
  die "a lid-sleep override is active. Run awake off to restore it before starting a password-free session."
fi
stop_unlock || exit 1
stop_caffeinate # replace any caffeinate we already started

# Tear down any guard left over from an earlier session. Live-state-checked
# (like `off`), so this still runs even if this invocation's own password
# prompt below is declined — a stale guard from a PRIOR session can otherwise
# keep disablesleep=1 in force while we print "closing the lid will still
# sleep," which would be a lie.
restore_lid_if_needed

# Record whether a built-in mic exists BEFORE the lid can close, so that after
# the session we can tell "macOS didn't give it back" apart from "this Mac never
# had one." Only meaningful for a lid session; idle-only sessions never lose it.
rm -f "$MICFILE"
mic_expected=0
if ((lid_ok == 1)) && builtin_mic_present; then
  echo 1 >"$MICFILE"
  mic_expected=1
fi

nohup caffeinate -dimsu -t "$seconds" >/dev/null 2>&1 &
printf '%s %s\n' "$!" "$seconds" >"$PIDFILE"
echo "$(($(date +%s) + seconds))" >"$UNTILFILE"

if ((lid_ok == 1)); then
  # One root-owned guard disables clamshell sleep, watches for lid reopen,
  # repairs a missing built-in mic, and restores sleep when the timer ends.
  # The subcommand name lets `awake off` find and stop it. nohup lets it survive
  # closing this terminal.
  nohup sudo env AWAKE_STATE_DIR="$STATE" "$SCRIPT_PATH" awake-lid-guard "$seconds" "$mic_expected" >/dev/null 2>&1 &
  echo "$(($(date +%s) + seconds))" >"$LIDFILE"
fi

if ((unlock == 1)); then
  if ! start_unlock; then
    stop_unlock || true
    stop_caffeinate
    restore_lid_if_needed
    die "idle-lock prevention could not start; the session was stopped. See $STATE/unlock.log."
  fi
fi

h=$((seconds / 3600))
m=$(((seconds % 3600) / 60))
dur=""
((h > 0)) && dur="${h}h"
((m > 0)) && dur="${dur}${m}m"
[[ -z "$dur" ]] && dur="${seconds}s"

if ((lid_ok == 1)); then
  printf "☕️🔒  Mac will stay awake for %s (until %s) — lid can be CLOSED.\n" "$dur" "$(clock "$(cat "$UNTILFILE")")"
  echo "    Built-in mic returns after reopening; use an external mic while closed."
  echo "    Runs full-power with the screen off — plug in for long sessions."
else
  printf "☕️  Mac will stay awake for %s (until %s) — no admin password; lid sleep stays normal.\n" "$dur" "$(clock "$(cat "$UNTILFILE")")"
fi
if ((unlock == 1)); then
  echo "🔓  Idle-lock prevention is on for this session; previous timeout restores automatically."
  echo "    Start unlocked and keep the lid open for GUI agents. Manual locks still work."
fi
echo "    Close this terminal freely. Stop early (and restore sleep) with:  awake off"
